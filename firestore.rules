rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pincLocks/{lockId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && (
                      resource.data.ownerUid == request.auth.uid
                      || resource.data.heartbeatAt < request.time - duration.value(2, 'm')
                    );
      allow delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;
    }
    match /pincShared/{docId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && docId == 'core'
                            && request.resource.data.keys().hasOnly(['agenda','welcomeSchedule','locations','reports','participants','absents','updatedAtMillis','updatedBy']);
      allow delete: if false;
    }
    match /musicRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['song','artist','requester','location','ownerUid','createdAt','createdAtMillis'])
                    && request.resource.data.song is string
                    && request.resource.data.artist is string
                    && request.resource.data.location is string
                    && request.resource.data.song.size() > 0
                    && request.resource.data.song.size() <= 100
                    && request.resource.data.artist.size() > 0
                    && request.resource.data.artist.size() <= 100;
      allow update, delete: if false;
    }
    match /pincMeta/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}